# Backend API origin the SPA talks to.
# Local dev can leave this blank to use the Vite /api proxy → http://localhost:8000.
# On Vercel set to the backend origin, e.g. https://axolot-283e.onrender.com
VITE_BACKEND_URL=
VITE_API_URL=

# Feature flags (optional, default off).
VITE_GMAIL_ENABLED=true
VITE_CALENDAR_ENABLED=true
VITE_A2A_ENABLED=true

# Reference only — the Google OAuth URL is built entirely by the backend.
VITE_GOOGLE_CLIENT_ID=
