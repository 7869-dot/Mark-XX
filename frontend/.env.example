# Base URL the SPA uses to reach the backend API.
# In dev this defaults to /api (Vite proxy → http://localhost:8000).
# In prod set to your Railway backend origin, e.g. https://axolot-api.up.railway.app
VITE_API_BASE_URL=/api

# NOTE: the Google OAuth URL is built entirely by the BACKEND. The frontend
# only does window.location.href = <authorization_url returned by the API>,
# so VITE_GOOGLE_CLIENT_ID / VITE_GOOGLE_REDIRECT_URI are NOT used by the app.
# Left here only for reference; safe to leave blank.
VITE_GOOGLE_CLIENT_ID=
