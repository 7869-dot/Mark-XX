# ─── Core ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://axolot:axolot@localhost:5432/axolot
JWT_SECRET=dev-jwt-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
FRONTEND_URL=http://localhost:5173
SCHEDULER_TIMEZONE=UTC

# Stub mode: when true, Gemini + Gmail/Calendar return canned data and the
# Google OAuth flow is faked. Flip to false for live integrations.
USE_STUBS=true

# ─── Gemini ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Google OAuth (login + Gmail/Calendar) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MUST exactly match the Authorized Redirect URI in Google Cloud Console.
# NOTE: the backend callback route is /integrations/google/callback
#   local: http://localhost:8000/integrations/google/callback
#   prod:  https://<your-railway-domain>/integrations/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback

# Space-separated OAuth scopes. gmail.modify + calendar are RESTRICTED scopes
# and require Google app verification for external/public users.
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/calendar

# Fernet key used to encrypt Google tokens at rest. Leave empty for a derived
# dev key (insecure). Generate a real one for production:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=
