# ── Gemini ─────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIza...

# ── Google OAuth (Phase 2) ─────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URIs must include: http://localhost:8000/auth/callback
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# JWT — change this to a long random secret in any non-local environment
JWT_SECRET=change-me-in-production-please
JWT_EXP_HOURS=24

# ── App ─────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# DEV_MODE=true allows X-User-Id header as auth fallback for seeded test users.
# Set to false (default) in any internet-accessible environment.
DEV_MODE=true

# ── External services ───────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# Gmail SMTP (for the email-draft send path, independent of OAuth)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Database ─────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./axolotl.db

# ── A2A Matchmaking tuning (optional) ────────────────────────────────────────────
A2A_MATCH_THRESHOLD=0.55
A2A_MAX_TURNS=6
A2A_TURN_TOKENS=512
A2A_COOLDOWN_DAYS=7
A2A_SCHEDULE_MINUTES=60
