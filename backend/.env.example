ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Gmail SMTP — use an App Password (not your main password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Database (SQLite default — change to postgresql://... for production)
DATABASE_URL=sqlite:///./axolotl.db

# A2A Matchmaking tuning (optional — defaults shown)
A2A_MATCH_THRESHOLD=0.55   # LLM judge score cutoff 0–1
A2A_MAX_TURNS=6            # total negotiation turns (3 per agent)
A2A_TURN_TOKENS=512        # max tokens per negotiation turn
A2A_COOLDOWN_DAYS=7        # days before same pair can be re-evaluated
A2A_SCHEDULE_MINUTES=60    # how often background matchmaker runs
