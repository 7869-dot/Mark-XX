# ─── Core ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://axolot:axolot@localhost:5432/axolot
# Canonical signing secret (Render sets SECRET_KEY). JWT_SECRET still works.
SECRET_KEY=dev-secret-change-me
FRONTEND_URL=http://localhost:5173
AXOLOT_BACKEND_URL=http://localhost:8000
SCHEDULER_TIMEZONE=UTC

# Force-stub override. Leave UNSET (or false) in production — each service
# auto-goes-live as soon as its own key is present (GEMINI_API_KEY, Google
# creds). Set true ONLY for offline local dev / tests, where it makes Gemini
# and the Gmail/Calendar/OAuth flows return deterministic canned data.
USE_STUBS=true

# ─── Gemini ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in callback (openid email profile). Must match the Authorized Redirect
# URI in Google Cloud Console.
#   local: http://localhost:8000/auth/google/callback
#   prod:  https://<backend-domain>/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Gmail/Calendar offline grant callback (broader restricted scopes). Defaults
# to {AXOLOT_BACKEND_URL}/integrations/google/callback when left blank.
GMAIL_REDIRECT_URI=
CALENDAR_REDIRECT_URI=

# ─── Encryption ─────────────────────────────────────────────────────────────
# Fernet key for Google tokens at rest (Render sets ENCRYPTION_KEY). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── Refresh-token cookie ───────────────────────────────────────────────────
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
