# ── Gemini (replaces Anthropic) ────────────────────────────────────────────────
GOOGLE_API_KEY=AIza...

# ── External services ──────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# Gmail SMTP — use an App Password (not your main password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./axolotl.db

# ── A2A Matchmaking tuning (optional — defaults shown) ─────────────────────────
A2A_MATCH_THRESHOLD=0.55
A2A_MAX_TURNS=6
A2A_TURN_TOKENS=512
A2A_COOLDOWN_DAYS=7
A2A_SCHEDULE_MINUTES=60
